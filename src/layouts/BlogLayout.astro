---
import "../styles/global.css";

import CommonHead from "../components/CommonHead.astro";
import Header from "../components/Header.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <CommonHead title={title} />
  <body>
    <Header />
    <slot />
  </body>
</html>
