---
import { getCollection, render } from "astro:content";
import { format } from "date-fns";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { transformToNestedArray } from "../../utils/headings";
import Headings from "../../components/blog/Headings.astro";

// Define static outputs
export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
// Content element and markdown headings
const { Content, headings } = await render(post);
// front matter
const { author, title, created, modified } = post.data;

const converted_heading = transformToNestedArray(headings);
---

<BlogLayout title={title}>
  <div class="flex flex-col items-center justify-center min-h-screen">
    <body>
      <div>
        <h1>{title} by {author}</h1>
        <p>Written on: {format(created, "h:m b LLL do, y")}</p>
        <p>
          Updated on: <p class="tooltip" data-tip={modified}>
            {format(modified, "h:m b LLL do, y")}
          </p>
        </p>
      </div>
      <main class="">
        <article class="prose min-w-19/20 max-w-full">
          <Content />
        </article>
      </main>
    </body>
  </div>
</BlogLayout>
